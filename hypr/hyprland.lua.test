-- Minimal test Lua config
local home = os.getenv("HOME")
local hypr = home .. "/.config/hypr"

package.path = package.path .. ";" .. hypr .. "/?.lua"

hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = 1,
})

-- Bind some keys
hl.keybind({
    key      = "Q",
    mods     = { "SUPER" },
    exec     = "foot"
})

hl.keybind({
    key      = "C",
    mods     = { "SUPER" },
    exec     = "killactive",
})

hl.exec("waybar")
hl.exec("dunst")
