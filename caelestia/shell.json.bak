{
    "appearance": {
        "anim": {
            "durations": {
                "scale": 0.7
            }
        },
        "font": {
            "family": {
                "sans": "JetBrains Mono"
            },
            "size": {
                "scale": 0.9991052119377162
            }
        },
        "transparency": {
            "base": 0.4952962802768166,
            "enabled": true,
            "layers": 0.3016429227941177
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true,
                "enabled": false,
                "opacity": 0.7021429409005628
            },
            "enabled": false,
            "shadow": {
                "blur": 0.401281074108818,
                "opacity": 0.6959647631332083
            }
        },
        "enabled": true,
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": false
        },
        "clock": {
            "background": true,
            "showDate": true,
            "showIcon": false
        },
        "persistent": false,
        "showOnHover": true,
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": true,
            "showLockStatus": true,
            "showMicrophone": true,
            "showNetwork": true,
            "showWifi": false
        },
        "tray": {
            "background": true,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "maxWindowIcons": 10,
            "showWindows": false,
            "shown": 10
        }
    },
    "border": {
        "rounding": 12,
        "smoothing": 1,
        "thickness": 1
    },
    "launcher": {
        "enableDangerousActions": true,
        "showOnHover": true,
        "vimKeybinds": false
    },
    "notifs": {
        "defaultExpireTimeout": 3000,
        "openExpanded": true
    },
    "osd": {
        "enableBrightness": true,
        "enableMicrophone": true,
        "hideDelay": 1500
